{
  "name": "flight-deck",
  "version": "0.1.0",
  "description": "Multi-agent coding dashboard",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:uat": "electron-vite dev -- --remote-debugging-port=9222",
    "build": "npm run build:mobile && electron-vite build",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.3",
    "electron": "^41.2.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@hono/node-server": "^1.19.13",
    "@opencode-ai/sdk": "^1.3.17",
    "@types/qrcode": "^1.5.6",
    "chokidar": "^5.0.0",
    "eventsource": "^4.1.0",
    "hono": "^4.12.12",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
